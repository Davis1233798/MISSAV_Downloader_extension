{
  "manifest_version": 3,
  "name": "MissAV Multi-Source Downloader",
  "version": "1.0.0",
  "description": "Discover and verify HLS mirror sources, then download with bounded-memory concurrent workers on Chrome and Brave.",
  "permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://missav.ws/*",
        "*://missav.live/*",
        "*://missav.ai/*",
        "*://missav123.com/*",
        "*://missav.fans/*",
        "*://missav.media/*"
      ],
      "js": [
        "sniffer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://missav.ws/*",
        "*://missav.live/*",
        "*://missav.ai/*",
        "*://missav123.com/*",
        "*://missav.fans/*",
        "*://missav.media/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "MissAV Multi-Source Video Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}

{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": [
    "clipboardWrite",
    "downloads"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://missav.ws/*",
        "*://missav.live/*",
        "*://missav.ai/*",
        "*://missav123.com/*",
        "*://missav.fans/*",
        "*://missav.media/*",
        "*://pornhub.com/*",
        "*://*.pornhub.com/*"
      ],
      "js": [
        "sniffer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://missav.ws/*",
        "*://missav.live/*",
        "*://missav.ai/*",
        "*://missav123.com/*",
        "*://missav.fans/*",
        "*://missav.media/*",
        "*://pornhub.com/*",
        "*://*.pornhub.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
